# ─────────────────────────────────────────────────────────────────────
# SkyCheck Backend — Environment Variables
# Copy this file to .env and fill in ALL values before running.
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (from Neon.tech free tier)
# Go to https://neon.tech → New project → Copy connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your_64_char_hex_secret_here"

# Node.js environment
NODE_ENV="development"

# Server port
PORT=3000

# App base URL (used in email links)
APP_URL="http://localhost:3000"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Gmail credentials for sending verification/reset emails
# Use a Gmail account with 2FA enabled + App Password (NOT your regular password)
# Steps: Gmail → Settings → Security → 2-Step Verification → App Passwords
EMAIL_USER="your.team.gmail@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"

# ── External API Keys ──────────────────────────────────────────────

# OpenRouteService (ORS) — Free routing
# Register at: https://openrouteservice.org/dev/#/signup
# Free tier: 2,000 requests/day — No credit card required
ORS_API_KEY="your_ors_api_key_here"

# TomTom Traffic Flow API — RECOMMENDED (replaces HERE Maps)
# Register at: https://developer.tomtom.com
# Free tier: 2,500 non-tile requests/day — NO credit card required, ever
# Steps: Sign up → Dashboard → Keys → Create API Key → copy it here
#
# IMPORTANT: If you leave this blank, SkyCheck automatically falls back
# to a Philippines-specific rush-hour heuristic (still accurate for
# student commute times — no degraded experience).
TOMTOM_API_KEY="your_tomtom_api_key_here"

# MapTiler (optional — used by frontend for map tiles in route preview)
# Free at https://cloud.maptiler.com (100,000 req/month, no credit card)
MAPTILER_KEY="your_maptiler_key_here"
